# LUCRUM Finance MCP — ortam değişkenleri şablonu
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun: cp .env.example .env

# TCMB EVDS API Key (evds2.tcmb.gov.tr > Profil > API Anahtarı)
TCMB_EVDS_API_KEY=your_key_here

# Twelve Data API Key (twelvedata.com > Dashboard > API Key)
TWELVE_DATA_API_KEY=your_key_here

# JWT imzalama anahtarı — ZORUNLU, kod içinde fallback yok.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_to_a_random_secret

# JWT access token ömrü (dakika)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS: virgülle ayrılmış, izin verilen frontend origin'leri
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend'in çalıştığı adres — email içindeki doğrulama/reset linkleri için kullanılır
FRONTEND_URL=http://localhost:3000

# Resend (transactional email) — boş bırakılırsa email gönderilmez, link log'a yazılır (dev mod)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lucrum Finance <onboarding@resend.dev>

# Refresh token cookie'sinin Secure flag'i — production'da (https) mutlaka true olmalı
COOKIE_SECURE=false

# Google Sign-In — Google Cloud Console > APIs & Services > Credentials'tan alınan
# OAuth 2.0 Client ID (Web application). Boş bırakılırsa /api/users/google-login 503 döner.
# Frontend'e de AYNI değer VITE_GOOGLE_CLIENT_ID olarak verilmeli.
GOOGLE_CLIENT_ID=

# Sentry (hata izleme) — boş bırakılırsa devre dışı, hiçbir veri gönderilmez
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backend'in dışarıdan erişilebilir adresi — Lemon Squeezy webhook URL'i için gerekli
BACKEND_URL=http://localhost:8000

# Lemon Squeezy (tek ödeme sağlayıcı — hem yerli hem uluslararası kart) — herhangi biri
# boş bırakılırsa checkout 503 döner. Store/Product/Variant Lemon Squeezy dashboard'ından
# oluşturulur (public API'de ürün oluşturma desteklenmiyor).
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ID_PRO=
LEMONSQUEEZY_VARIANT_ID_ENTERPRISE=
